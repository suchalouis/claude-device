{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://claude-pad.local/event",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://claude-pad.local/event",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://claude-pad.local/event",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "http",
            "url": "http://claude-pad.local/hook",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://claude-pad.local/event",
            "timeout": 2
          },
          {
            "type": "command",
            "async": true,
            "command": "python3 /chemin/vers/claude-pad/client/pad-usage.py --pad http://claude-pad.local"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://claude-pad.local/hook",
            "timeout": 120
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://claude-pad.local/event",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://claude-pad.local/event",
            "timeout": 2
          },
          {
            "type": "command",
            "async": true,
            "command": "python3 /chemin/vers/claude-pad/client/pad-usage.py --pad http://claude-pad.local"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://claude-pad.local/event",
            "timeout": 2
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://claude-pad.local/event",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
